# EditorConfig (https://editorconfig.org) — consistent editor settings
# across IDEs, terminals, and CI. Combined with `.gitattributes` (which
# forces LF in repo files), this guarantees that "works on my machine"
# formatting surprises don't leak into pull requests.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Markdown is sensitive to trailing spaces (two-space hard breaks). We
# intentionally do NOT trim them.

[*.rs]
max_line_length = 100
# rustfmt owns the formatting inside Rust files; the editor should not
# fight it.

[*.{css,scss,html}]
indent_size = 2

[Makefile]
indent_style = tab
