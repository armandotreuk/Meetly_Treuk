# Build artifacts
build/
meetily-build-target/
# FFmpeg build script is source code caught by the broad rule above:
# re-include its directory, ignore contents, then allow exactly this file
!upstream/frontend/src-tauri/build/
upstream/frontend/src-tauri/build/*
!upstream/frontend/src-tauri/build/ffmpeg.rs

# Upstream git metadata (we keep the code, not the .git)
upstream/.git/

# Node/pnpm
upstream/frontend/node_modules/
upstream/frontend/.next/
upstream/frontend/out/

# Rust
upstream/target/
target/

# OS
Thumbs.db
desktop.ini
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log
upstream/frontend/src-tauri/logs/

# Knowledge-graph analysis artifacts
graphify-out/

# Models (downloaded at runtime, not committed)
*.gguf
*.onnx

# Secrets
.env
.env.local
